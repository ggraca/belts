class SpinnerSystem < BeltsEngine::System
  query :spinners,
    with: [:rotation, :spinner]

  def start
    @spin = true
  end

  def update
    @spin = !@spin if @input.keyboard.key(:space).up?
    return unless @spin

    speed = @time.delta_time

    quat = Quat.from_euler(0, speed, 0)

    spinners.each_with_components do |rotation:|
      rotation.rotate!(quat)
    end
  end
end
